{
  "name": "food-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "dev:client": "vite",
    "dev:server": "mvn -f backend/pom.xml spring-boot:run",
    "db:schema": "node server/run-sql.js db/schema.sql",
    "db:seed": "node server/run-sql.js db/seed.sql",
    "db:java:migrate": "node server/run-sql.js db/java-backend-migration.sql",
    "docker:up": "docker compose up -d --build",
    "docker:ps": "docker compose ps",
    "backend:logs": "docker compose logs backend --tail=120",
    "dev:full": "docker compose up -d --build && node server/run-sql.js db/java-backend-migration.sql && node server/wait-for-backend.js && vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "mobile:start": "npm --prefix mobile run start",
    "mobile:android": "npm --prefix mobile run android",
    "mobile:ios": "npm --prefix mobile run ios"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "concurrently": "^10.0.0",
    "dotenv": "^17.4.2",
    "pg": "^8.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
}
